#!/bin/sh
# Pre-commit hook: lint and format staged files with Biome
#
# Runs `biome check --write` on staged files before each commit.
# If Biome modifies any files, they are automatically re-staged.

# Get list of staged JS/TS/JSON files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json)$')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Run biome check on staged files only
echo "$STAGED_FILES" | xargs npx @biomejs/biome check --write --no-errors-on-unmatched

# Re-stage any files that were modified
echo "$STAGED_FILES" | xargs git add

exit 0
